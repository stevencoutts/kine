# ─────────────────────────────────────────────────────────────
#  Kine  ::  environment
#  Generated from .env.example by install.sh. Do not commit .env
# ─────────────────────────────────────────────────────────────

# ---- Identity -------------------------------------------------
# Domain all apps are published under. Each app gets <app>.${KINE_DOMAIN}
KINE_DOMAIN=kine.local
# Wildcard DNS alias used only when Helm is opened on loopback for local testing.
KINE_LOCAL_DOMAIN=127.0.0.1.nip.io
KINE_TIMEZONE=Europe/London

# Master secret. Every internal API key is derived from this.
# Generated at install time. Changing it re-keys the whole stack.
KINE_SECRET=

# ---- Paths ----------------------------------------------------
# Stack state: config, backups, GUI database
STACK_ROOT=/srv/kine
# Media and downloads. MUST be a single filesystem (hardlink requirement)
DATA_ROOT=/srv/media-data

# ---- Ownership ------------------------------------------------
PUID=1000
PGID=1000
UMASK=002
# GID of the host 'render' group, detected by install.sh, for QSV
RENDER_GID=989

# ---- TLS ------------------------------------------------------
# One of: internal | acme-dns | custom
#   internal  Traefik's own CA. No domain or DNS required.
#   acme-dns  Let's Encrypt via DNS-01. Set KINE_ACME_* below.
#   custom    Bring your own cert. Drop fullchain.pem + privkey.pem
#             into ${STACK_ROOT}/config/traefik/certs/
KINE_TLS_MODE=internal

KINE_ACME_EMAIL=
# See https://doc.traefik.io/traefik/https/acme/#providers for codes
KINE_ACME_DNS_PROVIDER=cloudflare
# Provider credentials are read from ${STACK_ROOT}/config/traefik/acme.env
KINE_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Ports used by Traefik on the host. Defaults avoid clashing with
# another reverse proxy on 80/443. install.sh bumps these automatically
# when the chosen ports are already taken — no need to edit by hand.
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443

# ---- Media storage (optional NFS) -----------------------------
# Export paths on the NFS server. When set, mount-media.sh binds them
# onto the local tree under DATA_ROOT before containers start.
# Helm Settings can browse exports via showmount and pick paths.
# NFS_CACHE is the Tdarr transcode cache; leave empty for local disk.
# Example: NFS_SERVER=192.168.1.10  NFS_TV=/media/TV  NFS_MOVIES=/media/Movies
NFS_SERVER=
NFS_TV=
NFS_MOVIES=
NFS_DOWNLOADS=
NFS_CACHE=
# Docker Desktop only: Helm cannot mount NFS from inside the VM even when
# this Mac's IP is allowlisted. Run `sudo ./kine nfs-agent` and set:
# NFS_BROWSE_AGENT=http://host.docker.internal:8611
NFS_BROWSE_AGENT=

# ---- Enabled applications -------------------------------------
# Visible apps start disabled. Catalogue `default` flags choose which
# apps turn on when their section is enabled; they are not boot defaults.
# mDNS is hidden infrastructure and remains available from first boot.
COMPOSE_PROFILES=mdns

# Apps running a catalogue `dev_tag` image instead of the stable pin.
# Empty on a fresh install. Helm's Apps page toggles membership and
# rewrites the matching <APP>_TAG (saving the prior pin in
# <APP>_STABLE_TAG) the same way it rewrites COMPOSE_PROFILES.
APP_DEV_CHANNELS=

# ---- VPN (gluetun) --------------------------------------------
# Not optional while any tier 2 app is enabled: those apps have no
# network of their own, so without the tunnel they have no network.
VPN_ENABLED=true
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
VPN_SERVER_COUNTRIES="United Kingdom"
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn
# Subnets tunnelled containers may still reach directly (your LAN,
# and the docker bridge so Sonarr can talk to Transmission's RPC)
FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8
# Forced-tunnel acquisition apps (not Seerr: that stays on kine_internal).
# Restarting the tunnel restarts all of these together, and a VPN outage
# takes them offline. That is the point of a kill switch.
VPN_TUNNELLED_APPS=sonarr,radarr,prowlarr,jackett,bazarr,transmission,nzbget,unpackerr,recyclarr

# ---- Image pins -----------------------------------------------
# tag is for humans, digest is what actually gets pulled.
# The GUI updates these pairs. Leave a digest blank to track the tag.
TRAEFIK_TAG=v3.6.25
TRAEFIK_DIGEST=
SOCKETPROXY_TAG=0.3
SOCKETPROXY_DIGEST=
# Base image for the port-sync sidecar. Busybox tools only, no runtime
# package installs: the sidecar lives inside the tunnel, so an apk call
# would depend on the very thing it exists to monitor.
ALPINE_TAG=3.20
EMBY_TAG=latest
EMBY_DIGEST=
TDARR_TAG=latest
TDARR_DIGEST=
SONARR_TAG=latest
SONARR_DIGEST=
RADARR_TAG=latest
RADARR_DIGEST=
PROWLARR_TAG=latest
PROWLARR_DIGEST=
JACKETT_TAG=latest
JACKETT_DIGEST=
BAZARR_TAG=latest
BAZARR_DIGEST=
TRANSMISSION_TAG=latest
TRANSMISSION_DIGEST=
NZBGET_TAG=latest
NZBGET_DIGEST=
GLUETUN_TAG=v3
GLUETUN_DIGEST=
DISPATCHARR_TAG=latest
DISPATCHARR_DIGEST=
ECM_TAG=latest
ECM_DIGEST=
TEAMARR_TAG=latest
TEAMARR_DIGEST=
RECYCLARR_TAG=8
RECYCLARR_DIGEST=
UNPACKERR_TAG=latest
UNPACKERR_DIGEST=
SEERR_TAG=latest
SEERR_DIGEST=

# ---- Admin GUI ------------------------------------------------
HELM_BIND=0.0.0.0
HELM_PORT=8600
HELM_ADMIN_USER=admin
# Set on first boot through the onboarding wizard
HELM_ADMIN_HASH=
HELM_SESSION_SECRET=
# Check for image updates on this cron schedule. Never auto-applies.
HELM_UPDATE_CHECK_CRON="0 4 * * *"
