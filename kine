#!/usr/bin/env bash
# Kine CLI. Everything the GUI does, you can do here.
set -Eeuo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./scripts/lib.sh
[[ ! -f .env ]] || load_env .env

usage() {
cat <<'USAGE'
kine <command>

  up                    start everything enabled
  down                  stop everything
  restart [service]     restart one service, or all
  logs <service>        follow a service's logs
  ps                    what is running

  enable <app>          add an app to COMPOSE_PROFILES, start, wire it
  disable <app>         stop an app and remove it from COMPOSE_PROFILES
  apps                  list the catalogue and what is enabled

  provision [--force]   re-run the wiring (idempotent)
  seed                  write app config before first start
  rekey                 rotate KINE_SECRET and re-key every app

  updates               check for newer images (no pull)
  update <app>          snapshot, pull, recreate, roll back on failure

  vpn status            tunnel state and forwarded port
  vpn restart           restart the tunnel and everything inside it
  vpn leaktest          prove the tunnel is actually carrying traffic

  tls                   re-apply TLS config after changing KINE_TLS_MODE
  backup                config + env tarball
  restore <file> [app]  restore all, or one app's config

  nfs-agent             host NFS folder browser for Docker Desktop (needs sudo)
USAGE
}

profiles_add() {
  local app="$1"
  grep -q "^COMPOSE_PROFILES=" .env || echo "COMPOSE_PROFILES=" >> .env
  local cur; cur=$(grep '^COMPOSE_PROFILES=' .env | cut -d= -f2-)
  [[ ",$cur," == *",$app,"* ]] && return 0
  sedi "s|^COMPOSE_PROFILES=.*|COMPOSE_PROFILES=${cur:+$cur,}${app}|" .env
}

profiles_remove() {
  local app="$1"
  local cur; cur=$(grep '^COMPOSE_PROFILES=' .env | cut -d= -f2-)
  local new; new=$(echo "$cur" | tr ',' '\n' | grep -vx "$app" | paste -sd,)
  sedi "s|^COMPOSE_PROFILES=.*|COMPOSE_PROFILES=${new}|" .env
}

pihole_gate() {
  PYTHONPATH=helm/backend python3 - <<'PY'
from app import config, pihole_dns
env = config.read()
try:
    updates = pihole_dns.gate(env, pihole_dns.read_port53())
except pihole_dns.PiholeRejected as exc:
    raise SystemExit(str(exc))
except RuntimeError as exc:
    raise SystemExit(str(exc))
if updates:
    config.write(updates)
PY
}

pihole_sync() {
  PYTHONPATH=helm/backend python3 - <<'PY'
import os
from app import config, vpn_profiles, vpn_routing
env = config.read()
stack = env.get("STACK_ROOT") or os.environ.get("KINE_ROOT", ".")
store = vpn_profiles.migrate_from_wg0(stack)
profiles = {p.strip() for p in env.get("COMPOSE_PROFILES", "").split(",") if p.strip()}
enabled = {
    a.strip()
    for a in env.get("VPN_TUNNELLED_APPS", "").split(",")
    if a.strip() and a.strip() in vpn_routing.APP_PORTS and a.strip() in profiles
}
vpn_routing.apply_filesystem(
    stack,
    ".",
    store,
    enabled,
    kine_domain=env.get("KINE_DOMAIN") or "",
    kine_local_domain=env.get("KINE_LOCAL_DOMAIN") or "127.0.0.1.nip.io",
    vpn_enabled=env.get("VPN_ENABLED") == "true",
    pihole_enabled="pihole" in profiles,
)
PY
}

pihole_recreate() {
  local names
  names=$(PYTHONPATH=helm/backend python3 - <<'PY'
from app import config, pihole_dns
print(" ".join(pihole_dns.services_to_recreate(config.read())))
PY
)
  # shellcheck disable=SC2086
  [[ -n "$names" ]] && docker compose up -d --force-recreate $names
}

# gluetun's dependants lose their networking when it restarts, so the
# whole tunnel group goes together or not at all. That group is every
# forced-tunnel acquisition app (not Seerr), which makes this restart
# a bigger event than it looks: expect roughly a minute of no *arr and
# no downloads.
vpn_group() {
  PYTHONPATH=helm/backend python3 - <<'PY'
import os
from app import config, vpn_profiles, vpn_routing

env = config.read()
profiles = {p.strip() for p in env.get("COMPOSE_PROFILES", "").split(",") if p.strip()}
if "gluetun" not in profiles or env.get("VPN_ENABLED") != "true":
    raise SystemExit(0)
stack = env.get("STACK_ROOT") or os.environ.get("KINE_ROOT", ".")
store = vpn_profiles.migrate_from_wg0(stack)
enabled = {
    a.strip()
    for a in env.get("VPN_TUNNELLED_APPS", "").split(",")
    if a.strip() and a.strip() in vpn_routing.APP_PORTS and a.strip() in profiles
}
services: list[str] = []
for svc in vpn_routing.active_tunnel_services(store):
    services.extend(vpn_routing.recreate_group(store, svc, enabled))
seen: set[str] = set()
for name in services:
    if name not in seen:
        seen.add(name)
        print(name, end=" ")
print()
PY
}

cmd="${1:-}"; shift || true
case "$cmd" in
  up)
    gen=compose/vpn-routing.generated.yml
    [[ -f "$gen" ]] || echo 'services: {}' > "$gen"
    docker compose up -d ;;
  down)      docker compose down ;;
  restart)
    if [[ "${1:-}" == "gluetun" ]]; then
      echo "Restarting gluetun alone would sever every app inside it:"
      echo "  ${VPN_TUNNELLED_APPS}"
      echo "Use: ./kine vpn restart"; exit 1
    fi
    docker compose restart ${1:-} ;;
  logs)      docker compose logs -f --tail=200 "${1:?service}" ;;
  ps)        docker compose ps ;;

  enable)
    app="${1:?app}"
    if [[ "$app" == "pihole" ]]; then
      pihole_gate
      profiles_add gluetun
    fi
    profiles_add "$app"
    load_env .env
    if [[ "$app" == "pihole" ]]; then
      pihole_sync
    fi
    # Seed before start so *arr apps adopt derived keys on first run.
    docker compose run --rm provision seed
    if [[ "$app" == "pihole" ]]; then
      pihole_recreate
    else
      docker compose up -d
    fi
    docker compose run --rm provision wire ;;
  disable)
    app="${1:?app}"
    docker compose stop "$app" 2>/dev/null || true
    docker compose rm -f "$app" 2>/dev/null || true
    profiles_remove "$app"
    if [[ "$app" == "pihole" ]]; then
      load_env .env
      pihole_sync
      pihole_recreate
    fi
    ;;
  apps)
    python3 - <<'PY'
import os, yaml
cat = yaml.safe_load(open('catalogue.yml'))['apps']
env = dict(l.strip().split('=',1) for l in open('.env') if '=' in l and not l.startswith('#'))
on = set(env.get('COMPOSE_PROFILES','').split(','))
for k, v in cat.items():
    print(f"  [{'x' if k in on else ' '}] {k:<14} {v.get('summary','')}")
PY
    ;;

  seed)      docker compose run --rm provision seed ;;
  rekey)
    # Every internal API key is derived from KINE_SECRET, so rotating it
    # re-keys the whole stack at once. Anything outside the stack that
    # holds an old key (a phone app, a script, Tautulli) stops working
    # until it is given the new one.
    cat <<'WARN'
This rotates KINE_SECRET and every derived API key.

  - all stack-internal wiring is rebuilt automatically
  - any EXTERNAL client holding an old API key will break
  - a config snapshot is taken first

WARN
    read -r -p "Type 'rekey' to continue: " confirm
    [[ "$confirm" == "rekey" ]] || { echo "aborted"; exit 1; }
    ./scripts/backup.sh
    sedi "s|^KINE_SECRET=.*|KINE_SECRET=$(openssl rand -hex 32)|" .env
    docker compose down
    # Existing config.xml files hold the old key and are never
    # overwritten by the seeder, so they have to go first.
    for a in sonarr radarr prowlarr; do
      rm -f "${STACK_ROOT}/config/${a}/config.xml"
    done
    rm -f "${STACK_ROOT}/config/jackett/Jackett/ServerConfig.json"
    docker compose run --rm provision seed
    docker compose up -d
    docker compose run --rm provision wire
    echo "rekeyed" ;;
  provision) docker compose run --rm provision wire ;;

  updates)   ./scripts/updates.sh check ;;
  update)    ./scripts/updates.sh apply "${1:?app}" ;;

  vpn)
    case "${1:-status}" in
      status)
        docker exec kine-gluetun wget -qO- http://127.0.0.1:8000/v1/openvpn/status || true
        echo
        docker exec kine-gluetun wget -qO- http://127.0.0.1:8000/v1/openvpn/portforwarded || true
        echo ;;
      restart)   docker compose restart $(vpn_group) ;;
      leaktest)  ./scripts/vpn-leaktest.sh ;;
      *) usage; exit 1 ;;
    esac ;;

  tls)       ./scripts/tls-setup.sh && docker compose restart traefik ;;
  backup)    ./scripts/backup.sh ;;
  restore)   ./scripts/restore.sh "$@" ;;
  nfs-agent) exec python3 ./scripts/nfs-browse-agent.py ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
